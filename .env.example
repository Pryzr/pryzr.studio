# Create .env.local from this file and provide the real Resend API key.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# This address must be verified in Resend before production use.
LEAD_FROM_EMAIL=Pryzr Studio <leads@pryzr.studio>
LEAD_TO_EMAIL=brandon@pryzr.com
CALENDLY_EVENT_URL=https://calendly.com/brandon-pryzr/white-label-solutions
# Create this conversion access token in Reddit Events Manager and store it only as a Vercel secret.
REDDIT_CONVERSION_ACCESS_TOKEN=re_replace_with_your_reddit_conversion_access_token
# Admin portal secrets. Create ADMIN_PASSWORD_HASH as "<random-salt>:<scrypt-hash>".
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_HASH=re_replace_with_a_scrypt_password_hash
ADMIN_SESSION_SECRET=re_replace_with_a_random_session_secret
# Required to load live provider reports into the admin portal.
GOOGLE_ANALYTICS_PROPERTY_ID=replace_with_your_ga4_property_id
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=replace_with_your_service_account_json
CLARITY_API_TOKEN=replace_with_your_clarity_api_token
REDDIT_ADS_ACCESS_TOKEN=replace_with_your_reddit_ads_reporting_token
REDDIT_ADVERTISER_ID=replace_with_your_reddit_advertiser_id
